{
  "manifest_version": 3,
  "name": "Verified Asset",
  "version": "0.1.0",
  "description": "Shows a Verified Asset evidence report on Facebook Marketplace item pages. Independent demo, not affiliated with Meta.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://verified.ciberpty.com/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Verified Asset settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://www.facebook.com/*"]
    }
  ]
}
