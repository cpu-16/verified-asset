# Copy to .env or export these in your shell. Everything is optional.

# Meta API key. Muse Spark observes and SAM gives second opinions.
MODEL_API_KEY=

# Or use a local OpenAI-compatible server instead (for example Muse Glimmer in LM Studio).
# LOCAL_MODEL_URL=http://127.0.0.1:1234/v1
# LOCAL_MODEL_ID=muse-glimmer-30b

# Where the SQLite database, photos, caches and the spend ledger live.
# DATA_DIR=data

# Spending caps for paid model calls, in USD, and the per-listing daily check quota.
# SPEND_CAP_USD=10
# SPEND_DAILY_USD=2
# CHECKS_PER_LISTING_PER_DAY=5
